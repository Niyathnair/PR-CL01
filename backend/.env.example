# crowdLens authenticates to Claude using your existing Claude credentials.
# No API key needs to live on disk for local development.
#
# Recommended: generate a subscription OAuth token
#     claude setup-token
# then paste it here (or export it in your shell):
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback, and the only appropriate option for a multi-user deployment:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown in app/config.py)
# CROWDLENS_PERSONA_MODEL=claude-sonnet-5
# CROWDLENS_TARGET_K=11

# --- Ingest (optional) ---
# Live news sync runs on GDELT + RSS with no auth and no keys. Apify is
# optional: it supplies social reaction volume through managed actors, so no
# personal X account or session cookie is ever involved, and a customer can
# supply their own token. Without it the pipeline still works.
# CROWDLENS_APIFY_TOKEN=apify_api_...
# CROWDLENS_SYNC_INTERVAL_HOURS=6
# CROWDLENS_SYNC_ON_STARTUP=false
